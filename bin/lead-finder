#!/usr/bin/env node
/**
 * lead-finder CLI entry point
 *
 * Usage:
 *   lead-finder start                 Start the MCP server (stdio)
 *   lead-finder find-leads            Discover leads via Tavily search
 *   lead-finder send-email <email>    Send a personalized cold email
 *   lead-finder check-replies         Poll IMAP inbox and classify replies
 *   lead-finder status                # View campaign statistics
 *   lead-finder --config | -config    # Interactive TUI setup wizard
 *   lead-finder --tui                 # Launch TUI menu
 *   lead-finder --help | -h           # Show this help message
 *
 * Requires Python backend (requirements.txt) and .env config.
 */

const { spawnSync } = require('child_process');
const path = require('path');
const { prompt } = require('enquirer');
const chalk = require('chalk');
const { checkEnvComplete, ENV_FILE } = require('../src/config');
const { welcome, configWizard, mainMenu, dashboard } = require('../src/tui');

const { green, red, yellow, cyan, gray } = chalk;

const PROJECT_ROOT = path.resolve(__dirname, '..');
const PYTHON_BIN = process.env.LEAD_FINDER_PYTHON || (process.platform === 'win32' ? 'python' : 'python3');
const MAIN_SCRIPT = path.join(PROJECT_ROOT, 'src', 'main.py');

function runPython(args = []) {
  const result = spawnSync(PYTHON_BIN, [MAIN_SCRIPT, ...args], {
    cwd: PROJECT_ROOT,
    stdio: 'inherit',
    env: { ...process.env },
  });
  if (result.error) console.error(`Could not start Python: ${result.error.message}`);
  return result.status == null ? 1 : result.status;
}

async function previewAndSend(email, company, personalization, category) {
  const result = spawnSync(PYTHON_BIN, [MAIN_SCRIPT, 'send-email', '--email', email,
    '--company', company || '', '--personalization', personalization || '',
    '--category', category, '--preview'], { cwd: PROJECT_ROOT, encoding: 'utf8', env: { ...process.env } });
  if (result.status !== 0) {
    console.error(result.stderr || result.error?.message || result.stdout || 'Could not create draft');
    return;
  }
  let draft;
  try { draft = JSON.parse(result.stdout); }
  catch (_) { console.error('Could not read the generated draft.'); return; }
  if (result.stderr) console.error(result.stderr.trim());
  console.log(`\nTo: ${draft.email}\nSubject: ${draft.subject}\n\n${draft.body}\n`);
  const { confirmed } = await prompt({ type: 'confirm', name: 'confirmed',
    message: `Send this exact draft to ${draft.email}?`, initial: false });
  if (confirmed) runPython(['send-draft', '--id', String(draft.draft_id)]);
  else console.log(`Draft ${draft.draft_id} saved. Send later with lead-finder send-draft --id ${draft.draft_id}`);
}

function showHelp() {
  console.log(`
lead-finder — Lead discovery and individual outreach

Usage:
  lead-finder start                 Start the MCP server (stdio)
  lead-finder find-leads            Discover new leads via Tavily search
  lead-finder send-email --email <address> [--preview]  Preview or send an email
  lead-finder check-replies         Poll IMAP inbox and classify replies
  lead-finder status                View campaign statistics
  lead-finder --config | -config    # Interactive TUI setup wizard
  lead-finder --tui                 # Launch TUI menu
  lead-finder --help | -h           # Show this help message

Examples:
  lead-finder start
  lead-finder find-leads --industry "handyman" --location "Portland, OR"
  lead-finder send-email --email grace@example.com --company "Grace Cleaning"
  lead-finder check-replies
  lead-finder status
  lead-finder --config

Configuration:
  Run 'lead-finder --config' to set up your API keys interactively via TUI.
  Configure only the services you use; OpenRouter is optional.
  Settings are stored in ~/.lead-finder (or LEAD_FINDER_HOME).
`);
}

async function runDashboardTUI() {
  welcome();

  if (!checkEnvComplete()) {
    console.log(`${yellow('Configuration is incomplete. Choose config to set up services.')}\n`);
  }

  let running = true;
  while (running) {
    // Fetch stats via separate Python call with captured output
    const statsResult = spawnSync(PYTHON_BIN, [MAIN_SCRIPT, 'status'], {
      cwd: PROJECT_ROOT,
      encoding: 'utf-8',
      env: { ...process.env },
    });
    let parsedStats = {};
    try {
      parsedStats = JSON.parse(statsResult.stdout);
    } catch (e) {
      parsedStats = {};
    }

    dashboard(parsedStats);

    const { action } = await prompt({
      type: 'select',
      name: 'action',
      message: 'What would you like to do?',
      choices: [
        { name: 'find-leads', message: `${cyan('find-leads')}  — Discover new leads via Tavily` },
        { name: 'send-email', message: `${cyan('send-email')}  — Send a personalized cold email` },
        { name: 'check-replies', message: `${cyan('check-replies')}  — Poll IMAP and classify replies` },
        { name: 'status', message: `${cyan('refresh')}  — Refresh dashboard` },
        { name: 'config', message: `${cyan('config')}  — Edit settings` },
        { name: 'start-mcp', message: `${cyan('start-mcp')}  — Start MCP server (for OpenCode/KiloCode)` },
        { name: 'exit', message: `${gray('exit')}  — Quit` },
      ],
    });

    switch (action) {
      case 'find-leads':
        runPython(['find-leads']);
        break;
      case 'send-email': {
        const { email } = await prompt({
          type: 'input',
          name: 'email',
          message: 'Recipient email address:',
          required: true,
        });
        const { company } = await prompt({
          type: 'input',
          name: 'company',
          message: 'Company name (optional):',
        });
        const { personalization } = await prompt({
          type: 'input',
          name: 'personalization',
          message: 'Verified detail about the business (optional):',
        });
        const { category } = await prompt({
          type: 'select',
          name: 'category',
          message: 'Business category:',
          choices: [
            { name: 'services', message: 'Services' },
            { name: 'cleaning', message: 'Cleaning' },
            { name: 'landscaping', message: 'Landscaping' },
            { name: 'handyman', message: 'Handyman' },
            { name: 'auto detailing', message: 'Auto Detailing' },
            { name: 'pet grooming', message: 'Pet Grooming' },
            { name: 'pressure washing', message: 'Pressure Washing' },
          ],
        });
        await previewAndSend(email, company, personalization, category);
        break;
      }
      case 'check-replies':
        runPython(['check-replies']);
        break;
      case 'status':
        // Just refresh dashboard
        break;
      case 'config':
        await configWizard();
        break;
      case 'start-mcp':
        console.log(`\n${cyan('Starting MCP server...')}`);
        require('../src/mcp_server');
        running = false;
        break;
      case 'exit':
        console.log(`\n${green('Goodbye!')}\n`);
        running = false;
        break;
    }
    if (running && action !== 'start-mcp') {
      console.log(`\n${gray('Press Enter to continue...')}`);
      await new Promise((resolve) => process.stdin.once('data', () => resolve()));
    }
  }
}

async function runTUI() {
  welcome();

  if (!checkEnvComplete()) {
    console.log(`${yellow('Configuration is incomplete. Choose config to set up services.')}\n`);
  }
  let running = true;
  while (running) {
    const action = await mainMenu();

    switch (action) {
      case 'start':
        console.log(`\n${cyan('Starting MCP server...')}`);
        require('../src/mcp_server');
        running = false;
        break;
      case 'find-leads':
        runPython(['find-leads']);
        break;
      case 'send-email': {
        const { email } = await prompt({
          type: 'input',
          name: 'email',
          message: 'Recipient email address:',
          required: true,
        });
        const { company } = await prompt({
          type: 'input',
          name: 'company',
          message: 'Company name (optional):',
        });
        const { personalization } = await prompt({
          type: 'input',
          name: 'personalization',
          message: 'Verified detail about the business (optional):',
        });
        const { category } = await prompt({
          type: 'select',
          name: 'category',
          message: 'Business category:',
          choices: [
            { name: 'services', message: 'Services' },
            { name: 'cleaning', message: 'Cleaning' },
            { name: 'landscaping', message: 'Landscaping' },
            { name: 'handyman', message: 'Handyman' },
            { name: 'auto detailing', message: 'Auto Detailing' },
            { name: 'pet grooming', message: 'Pet Grooming' },
            { name: 'pressure washing', message: 'Pressure Washing' },
          ],
        });
        await previewAndSend(email, company, personalization, category);
        break;
      }
      case 'check-replies':
        runPython(['check-replies']);
        break;
      case 'status':
        runPython(['status']);
        break;
      case 'config':
        await configWizard();
        break;
      case 'exit':
        console.log(`\n${green('Goodbye!')}\n`);
        running = false;
        break;
    }
    if (running && action !== 'start') {
      console.log(`\n${gray('Press Enter to continue...')}`);
      await new Promise((resolve) => process.stdin.once('data', () => resolve()));
    }
  }
}

const cmd = process.argv[2];

async function main() {
  switch (cmd) {
    case 'start': {
      // If running in a TTY (interactive terminal), boot dashboard TUI
      // If running via stdio (MCP client like OpenCode/KiloCode), start MCP server
      const isTTY = process.stdin.isTTY && !process.env.NON_INTERACTIVE;

      if (isTTY) {
        await runDashboardTUI();
      } else {
        require('../src/mcp_server');
      }
      break;
    }
    case '--config':
    case '-config':
    case 'config':
      await configWizard();
      break;
    case '--tui':
    case '-tui':
    case 'tui':
      await runTUI();
      break;
    case 'find-leads':
    case 'find':
      process.exitCode = runPython(['find-leads', ...process.argv.slice(3)]);
      break;
    case 'send-email':
    case 'send-draft':
    case 'check-replies':
    case 'status':
    case 'blacklist':
    case 'search':
    case 'run':
      process.exitCode = runPython([cmd, ...process.argv.slice(3)]);
      break;
    case 'replies':
      process.exitCode = runPython(['check-replies', ...process.argv.slice(3)]);
      break;
    case 'stats':
      process.exitCode = runPython(['status', ...process.argv.slice(3)]);
      break;
    case '--help':
    case '-h':
      showHelp();
      process.exit(0);
    default:
      console.error(`Unknown command: ${cmd}`);
      showHelp();
      process.exit(1);
  }
}

main().catch((err) => {
  console.error(`${red('Fatal error:')} ${err.message}`);
  process.exit(1);
});
