# ── Required ──
OPENROUTER_API_KEY=your_openrouter_key_here
ENRICH_API_KEY=your_enrich_key_here

# ── SMTP Email (Gmail - free, no domain needed) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

FROM_NAME=Your Name
FROM_EMAIL=your_email@gmail.com
FROM_COMPANY=Your Company
VALUE_PROP=What you help businesses do

# ── Limits ──
DAILY_LIMIT=20

# ── Reply tracking (IMAP) ──
IMAP_HOST=imap.gmail.com
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_16_char_app_password

# ── Search API (Tavily - backup lead discovery) ──
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# ── Target ──
TARGET_INDUSTRY=B2B services
TARGET_LOCATION=United States

# ── Database ──
DB_PATH=leads.db
